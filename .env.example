# ── Shikayat environment configuration ─────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.

# App
APP_NAME=Shikayat
APP_VERSION=1.0.0
DEBUG=false

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Dev (SQLite):  sqlite:///./shikayat.db
# Prod (Postgres via docker-compose): postgresql+psycopg2://shikayat:shikayat_dev_password@db:5432/shikayat
DATABASE_URL=sqlite:///./shikayat.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://shikayat.vercel.app

# Reopen rule
REOPEN_WINDOW_DAYS=14
MAX_REOPENS=3
